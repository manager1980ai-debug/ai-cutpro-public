<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AICutPro.App.MainWindow"
        Title="AI CutPro — Интеллектуальное управление резкой"
        Width="1440" Height="900" MinWidth="1000" MinHeight="650"
        Background="#0B1523">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">
    <TextBlock Grid.Row="0" Text="AI CutPro   •   Локальный прототип • Без подключения к станку"
               Foreground="#E8F4FF" FontSize="21" FontWeight="Bold" Margin="4,6,4,14"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
      <Button Content="Задание" Click="TabClicked" Tag="Задание"/>
      <Button Content="Чертёж и модель" Click="TabClicked" Tag="Чертёж и модель"/>
      <Button Content="Раскрой" Click="TabClicked" Tag="Раскрой"/>
      <Button Content="Параметры резки" Click="TabClicked" Tag="Параметры резки"/>
      <Button Content="Симуляция" Click="TabClicked" Tag="Симуляция"/>
      <Button Content="Производство" Click="TabClicked" Tag="Производство"/>
      <Button Content="История" Click="TabClicked" Tag="История"/>
      <Button Content="Архив" Click="TabClicked" Tag="Архив"/>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="210,*,250">
      <Border Grid.Column="0" Background="#14263B" CornerRadius="10" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
          <TextBlock Text="Текущее задание" Foreground="#E8F4FF" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="Кронштейн × 10" Foreground="#81CBFF"/>
          <TextBlock Text="Материал: сталь S355" Foreground="White"/>
          <TextBlock Text="Толщина: 5 мм" Foreground="White"/>
          <TextBlock Text="Размер стола станка, мм" Foreground="#E8F4FF" FontWeight="Bold"/>
          <TextBox x:Name="TableWidthBox" Text="4000" Watermark="Ширина стола"/>
          <TextBox x:Name="TableHeightBox" Text="2000" Watermark="Высота стола"/>
          <TextBlock Text="Размер листа, мм" Foreground="#E8F4FF" FontWeight="Bold"/>
          <TextBox x:Name="SheetWidthBox" Text="3000" Watermark="Ширина листа"/>
          <TextBox x:Name="SheetHeightBox" Text="1500" Watermark="Высота листа"/>
          <Button Content="Применить размеры" Click="ApplyWorkspaceClicked"/>
          <Button Content="Новый раскрой" Click="NewLayoutClicked"/>
          <TextBlock Text="DXF: допуск соединения (мм)" Foreground="#E8F4FF" FontWeight="Bold"/>
          <TextBox x:Name="DxfToleranceBox" Text="0.01" Watermark="0.0001–1 мм"/>
          <TextBlock Text="DXF: подтвердите исходные единицы (необязательно для просмотра)" Foreground="#E8F4FF" TextWrapping="Wrap"/>
          <TextBox x:Name="DxfUnitsBox" Watermark="1=дюйм, 2=фут, 4=мм, 5=см, 6=м"/>
          <TextBlock Text="Пустое поле: только исходный просмотр, без пересчёта. Единицы не угадываются." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <Button Content="Открыть DXF (предпросмотр)" Click="ImportDxfClicked"/>
          <TextBlock Text="История изменений DXF (до 30 шагов)" Foreground="#E8F4FF" FontWeight="Bold"/>
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Content="Отменить изменение" Click="UndoDxfClicked"/>
            <Button Grid.Column="1" Content="Повторить изменение" Click="RedoDxfClicked"/>
          </Grid>
          <TextBlock Text="История хранится только в памяти приложения. При открытии другого файла или нового раскроя начинается заново." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Изменить контуры при сохранении DXF (мм, градусы)" Foreground="#E8F4FF" TextWrapping="Wrap" FontWeight="Bold"/>
          <TextBox x:Name="ExportMoveXBox" Text="0" Watermark="Смещение X, мм"/>
          <TextBox x:Name="ExportMoveYBox" Text="0" Watermark="Смещение Y, мм"/>
          <TextBox x:Name="ExportRotationBox" Text="0" Watermark="Поворот вокруг начала, °"/>
          <TextBlock Text="Изменить весь DXF-эскиз (предпросмотр; Undo/Redo)" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <Button Content="Применить перенос X/Y" Click="TranslateWholeDxfClicked"/>
          <TextBox x:Name="RotationPivotXBox" Text="0" Watermark="Центр поворота X, мм"/>
          <TextBox x:Name="RotationPivotYBox" Text="0" Watermark="Центр поворота Y, мм"/>
          <Button Content="Применить поворот вокруг заданной точки X/Y" Click="RotateWholeDxfClicked"/>
          <TextBox x:Name="MirrorAxisXBox" Text="0" Watermark="Вертикальная ось отражения, X мм"/>
          <Button Content="Зеркально отразить по вертикали" Click="MirrorWholeDxfClicked"/>
          <TextBox x:Name="MirrorAxisYBox" Text="0" Watermark="Горизонтальная ось отражения, Y мм"/>
          <Button Content="Зеркально отразить по горизонтали" Click="MirrorHorizontalDxfClicked"/>
          <TextBlock Text="Пропорциональное масштабирование всего DXF (предпросмотр)" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBox x:Name="ScaleFactorBox" Text="1" Watermark="Коэффициент масштаба (0.01–100)"/>
          <TextBox x:Name="ScalePivotXBox" Text="0" Watermark="Центр масштабирования X, мм"/>
          <TextBox x:Name="ScalePivotYBox" Text="0" Watermark="Центр масштабирования Y, мм"/>
          <Button Content="Применить масштаб ко всем контурам" Click="ScaleWholeDxfClicked"/>
          <TextBlock Text="Операции меняют текущий предпросмотр и добавляются в историю Undo/Redo. Применённые смещение/поворот автоматически сбрасываются в 0, чтобы экспорт не повторил их. CAM и запуск станка запрещены." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Вершина прямолинейного контура (нумерация с 1)" Foreground="#E8F4FF" TextWrapping="Wrap" FontWeight="Bold"/>
          <TextBox x:Name="EditRingIndexBox" Text="1" Watermark="Номер контура"/>
          <TextBox x:Name="EditVertexIndexBox" Text="1" Watermark="Номер вершины"/>
          <TextBox x:Name="EditVertexXBox" Text="0" Watermark="Новый X, мм"/>
          <TextBox x:Name="EditVertexYBox" Text="0" Watermark="Новый Y, мм"/>
          <Button Content="Переместить вершину (предпросмотр)" Click="EditDxfVertexClicked"/>
          <Button Content="Вставить вершину на ребро (предпросмотр)" Click="InsertDxfVertexClicked"/>
          <Button Content="Удалить вершину (предпросмотр)" Click="DeleteDxfVertexClicked"/>
          <TextBlock Text="Фаска прямолинейного угла (отступ по обоим рёбрам, мм)" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBox x:Name="ChamferSetbackBox" Text="5" Watermark="Отступ фаски, мм"/>
          <Button Content="Снять фаску выбранной вершины (предпросмотр)" Click="ChamferDxfVertexClicked"/>
          <TextBlock Text="Точное скругление угла дугой ARC (радиус, мм)" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBox x:Name="FilletRadiusBox" Text="5" Watermark="Радиус скругления, мм"/>
          <Button Content="Скруглить выбранный угол (предпросмотр)" Click="FilletDxfVertexClicked"/>
          <TextBlock Text="Сопряжение входящей прямой LINE и следующей дуги ARC (радиус, мм)" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBox x:Name="LineArcFilletRadiusBox" Text="5" Watermark="Радиус переходной дуги, мм"/>
          <Button Content="Построить касательное LINE/ARC сопряжение" Click="FilletLineArcClicked"/>
          <Button Content="Построить касательное ARC/LINE сопряжение" Click="FilletArcLineClicked"/>
          <TextBlock Text="Касательное сопряжение двух соседних дуг ARC" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBox x:Name="ArcArcFilletRadiusBox" Text="5" Watermark="Радиус соединительной ARC, мм"/>
          <Button Content="Построить касательное ARC/ARC сопряжение" Click="FilletArcArcClicked"/>
          <TextBlock Text="Номер сегмента выше указывает на вторую ARC после первой ARC. При отсутствии касательного решения DXF останется без изменений." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Номер сегмента выше должен указывать на исходную ARC после LINE. Работает только при геометрически допустимом касательном решении; иначе отказ без изменения DXF." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Номера контура и вершины выше; выпуклые и вогнутые LINE/LINE углы, в том числе в смешанном контуре LINE/ARC. Соседние ARC не редактируются. Проверяются геометрия и DXF; без CAM." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Использует номера контура и вершины выше. Только замкнутые LINE-контуры; проверяются отверстия и DXF." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Точный размер ребра, мм (номер вершины = начало ребра)" Foreground="#E8F4FF" TextWrapping="Wrap" FontWeight="Bold"/>
          <TextBox x:Name="EditEdgeLengthBox" Text="10" Watermark="Новая длина ребра, мм"/>
          <Button Content="Задать длину ребра (предпросмотр)" Click="SetDxfEdgeLengthClicked"/>
          <TextBlock Text="Абсолютный угол прямого ребра относительно +X, °" Foreground="#E8F4FF" TextWrapping="Wrap" FontWeight="Bold"/>
          <TextBox x:Name="EditEdgeAngleBox" Text="0" Watermark="Угол, градусы (-360…360)"/>
          <Button Content="Задать угол ребра (предпросмотр)" Click="SetDxfEdgeAngleClicked"/>
          <TextBlock Text="Геометрическое ограничение прямого ребра" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <Button Content="Выровнять ребро горизонтально" Click="ConstrainEdgeHorizontalClicked"/>
          <Button Content="Выровнять ребро вертикально" Click="ConstrainEdgeVerticalClicked"/>
          <TextBlock Text="Однократная фиксация направления: начальная вершина и длина ребра сохраняются. Номер ребра выше; только LINE-контуры. Это пока не постоянная параметрическая зависимость." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Радиус выбранной дуги ARC, мм (концы дуги закреплены)" Foreground="#E8F4FF" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBox x:Name="EditArcRadiusBox" Text="12" Watermark="Новый радиус, мм"/>
          <Button Content="Изменить радиус дуги (предпросмотр)" Click="EditSingleArcRadiusClicked"/>
          <TextBlock Text="Выберите номер контура и сегмента (1-based). Начальная и конечная точки дуги остаются неподвижны; форма контура проверяется." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Угол отсчитывается против часовой стрелки от +X. Начало и длина выбранного ребра сохраняются; меняется его конечная вершина." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Начало прямого ребра остаётся на месте; конец смещается по его направлению. Проверяются все отверстия и пересечения." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Вставка: номер вершины обозначает начало прямого ребра, X/Y задают точку на ребре. Удаление: X/Y не используются. Нумерация начинается с 1." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Только замкнутые прямолинейные контуры. Все изменения проверяются; дуговые вершины пока нельзя редактировать." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Редактирование круглого отверстия CIRCLE" Foreground="#E8F4FF" TextWrapping="Wrap" FontWeight="Bold"/>
          <TextBox x:Name="HoleCircleIndexBox" Text="1" Watermark="Номер CIRCLE, начиная с 1"/>
          <TextBox x:Name="HoleCenterXBox" Text="100" Watermark="Центр X, мм"/>
          <TextBox x:Name="HoleCenterYBox" Text="50" Watermark="Центр Y, мм"/>
          <TextBox x:Name="HoleDiameterBox" Text="20" Watermark="Диаметр, мм"/>
          <Button Content="Изменить круглое отверстие (предпросмотр)" Click="EditCircleHoleClicked"/>
          <Button Content="Изменить диаметр окружности из ARC (предпросмотр)" Click="EditArcCircleDiameterClicked"/>
          <TextBlock Text="Выберите номер контура выше и укажите диаметр. Работает только с полной окружностью из четырёх дуг ARC по 90°, не с произвольной дугой." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <Button Content="Добавить круглое отверстие (предпросмотр)" Click="AddCircleHoleClicked"/>
          <TextBlock Text="Только явный DXF CIRCLE внутри детали. Контуры, касания и вложенность проверяются; результат можно сохранить отдельно в DXF." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <Button Content="Сохранить проверенные контуры DXF" Click="ExportEditedDxfClicked"/>
          <TextBlock Text="Только замкнутые LINE/ARC/CIRCLE-контуры без предупреждений. Исходный файл не перезаписывается автоматически; резка отключена." TextWrapping="Wrap" Foreground="#9CB3C9"/>

          <TextBlock Text="Текстовый 2D-эскиз (мм)" Foreground="#E8F4FF" FontWeight="Bold"/>
          <TextBox x:Name="TextSketchBox" Text="PLATE 200 100 5; HOLE 50 50 10"
                   TextWrapping="Wrap" AcceptsReturn="True" Height="64"/>
          <Button Content="Построить пластину (2D + параметры 3D)" Click="BuildTextSketchClicked"/>
          <TextBlock Text="3D-модель из текущего отредактированного DXF" Foreground="#E8F4FF" FontWeight="Bold"/>
          <TextBox x:Name="Current3DThicknessBox" Text="5" Watermark="Толщина 3D, мм"/>
          <Button Content="Экспорт текущего DXF в 3D (.scad)" Click="ExportCurrentDxf3DClicked"/>
          <TextBlock Text="Использует текущие изменения DXF, включая Undo/Redo. Поддерживаются отдельные детали, прямолинейные вырезы, круглые отверстия и вложенные острова. Неподдерживаемые дуговые формы отклоняются, CAM запрещён." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <Button Content="Сохранить 3D-модель OpenSCAD (.scad)" Click="ExportPlate3DClicked"/>
          <TextBlock Text="3D-файл строится из текстовых параметров PLATE/HOLE, а не из последующих правок DXF. Открыть и визуализировать можно в OpenSCAD; это не CAM и не STL." Foreground="#9CB3C9" TextWrapping="Wrap"/>
          <TextBlock Text="Команды: PLATE ширина высота толщина; HOLE X Y радиус. Только параметрическая модель, без 3D-меша и резки." Foreground="#9CB3C9" TextWrapping="Wrap"/>

          <TextBlock Text="Управление станком отключено в прототипе." TextWrapping="Wrap" Foreground="#9CB3C9"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="#14263B" CornerRadius="10" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock x:Name="PanelTitle" Text="Раскрой листа 3000 × 1500 мм" FontSize="20" FontWeight="Bold" Foreground="#E8F4FF"/>
          <Canvas x:Name="SheetCanvas" Grid.Row="1" Background="#0B1E31" ClipToBounds="True"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="CanvasSizeChanged"/>
          <TextBlock Grid.Row="2" x:Name="StatusText" Text="Готово к симуляции" Foreground="#82D1FF"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="#14263B" CornerRadius="10" Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="Виртуальный станок" FontWeight="Bold" FontSize="18" Foreground="White"/>
          <TextBlock Text="Контроллер: не подключён" Foreground="#E0A45D"/>
          <TextBlock x:Name="WorkspaceText" Foreground="White" TextWrapping="Wrap"/>
          <TextBlock Text="Виртуальная головка (X/Y/Z), мм" Foreground="#E8F4FF" FontWeight="Bold"/>
          <Grid ColumnDefinitions="*,*,*">
            <TextBox x:Name="HeadXBox" Grid.Column="0" Text="0" Watermark="X"/>
            <TextBox x:Name="HeadYBox" Grid.Column="1" Text="0" Watermark="Y"/>
            <TextBox x:Name="HeadZBox" Grid.Column="2" Text="0" Watermark="Z"/>
          </Grid>
          <Button Content="Переместить виртуально" Click="MoveVirtualHeadClicked"/>
          <Button Content="Установить рабочий ноль" Click="SetWorkZeroClicked"/>
          <TextBlock x:Name="CoordinatesText" TextWrapping="Wrap" Foreground="#82D1FF"/>
          <TextBlock x:Name="CheckpointText" TextWrapping="Wrap" Foreground="#9CB3C9"/>
          <TextBlock x:Name="PartsText" Foreground="#80CBFF"/>
          <TextBlock Text="Выбранная деталь" FontWeight="Bold" Foreground="#E8F4FF" Margin="0,10,0,0"/>
          <TextBlock x:Name="SelectedPartText" TextWrapping="Wrap" Foreground="White"/>
          <TextBlock Text="Отверстия DXF (диаметры)" FontWeight="Bold" Foreground="#E8F4FF" Margin="0,10,0,0"/>
          <TextBlock x:Name="HoleSummaryText" TextWrapping="Wrap" Foreground="#81CBFF"/>
          <TextBlock Text="Колесо: масштаб • правая/средняя кнопка: сдвиг • левая: выбор детали" TextWrapping="Wrap" Foreground="#9CB3C9"/>
          <TextBlock x:Name="UtilizationText" Foreground="#4CE58A" FontSize="22" FontWeight="Bold"/>
          <TextBlock x:Name="WasteText" Foreground="White"/>
          <TextBlock Text="Примечание: первый алгоритм размещает ограничивающие прямоугольники деталей. Отверстия и траектории реза пока не рассчитаны."
                     TextWrapping="Wrap" Foreground="#9CB3C9"/>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="12" Margin="0,14,0,2">
      <Button Content="Ручное управление (виртуально)" Click="ManualClicked"/>
      <Button Content="Симуляция" Click="SimulateClicked"/>
      <Button Content="Сохранить" Click="SaveClicked"/>
      <Button Content="Запуск резки (недоступен)" IsEnabled="False"/>
    </StackPanel>
  </Grid>
</Window>
